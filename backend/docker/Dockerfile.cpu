# syntax=docker/dockerfile:1.7
# CPU runtime profile image.  For production builds pin every base image by digest
# (python@sha256:..., uv@sha256:...) and build with SOURCE_DATE_EPOCH for reproducibility.
ARG PYTHON_IMAGE=python:3.12-slim-bookworm
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.10.12

FROM ${UV_IMAGE} AS uv

FROM ${PYTHON_IMAGE} AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=0 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    MLREDACT_MODELS_DIR=/opt/mlredact/models
COPY --from=uv /uv /usr/local/bin/uv
# OCR engine B (Tesseract 5, Apache-2.0).  Its version is recorded in the runtime profile; pin the
# package version (or the base image digest) for production builds.
RUN apt-get update \
    && apt-get install -y --no-install-recommends tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src ./src
RUN uv sync --frozen --no-dev

# Models are fetched and SHA-256-verified at build time only; the runtime has no network.
FROM base AS models
RUN /opt/venv/bin/mlredact models fetch --profile broad --directory /opt/mlredact/models

FROM base AS runtime
COPY --from=models /opt/mlredact/models /opt/mlredact/models
ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    DO_NOT_TRACK=1 \
    MLREDACT_LOG_STRICT=0
RUN useradd --system --uid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin mlredact
USER 10001:10001
ENTRYPOINT ["/opt/venv/bin/mlredact"]
CMD ["selfcheck"]
