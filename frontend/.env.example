# Copy to .env.local (laptop) or set in the Vercel project settings.  Never commit real values.

# --- Backend API (the redaction server, e.g. on EC2) -------------------------------------------
# Where this app's server reaches the backend.  Laptop + SSH tunnel: http://127.0.0.1:8100
MLREDACT_API_URL=http://127.0.0.1:8100
# Where browsers reach it for direct uploads and downloads, if different (e.g. a public https URL).
# MLREDACT_API_PUBLIC_URL=https://api.example.com
# The same shared secret as the backend's MLREDACT_API_TOKEN (32+ characters).  Server-side only.
MLREDACT_API_TOKEN=

# --- Sign-in (next-auth) -------------------------------------------------------------------------
# Random secret for session cookies:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=
# This app's own address (Vercel sets it automatically for its domains).
NEXTAUTH_URL=http://localhost:3100

# Email-and-password users: comma-separated email=hash entries.  Make a hash with `npm run hash-password`.
MLREDACT_UI_USERS=

# Google sign-in (optional): an OAuth client from Google Cloud Console, with the redirect URI
#   <NEXTAUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Who may sign in with Google.  With neither list set, no Google account gets in.
# MLREDACT_UI_GOOGLE_ALLOWED_EMAILS=joel@example.com
# MLREDACT_UI_GOOGLE_ALLOWED_DOMAINS=example.com
